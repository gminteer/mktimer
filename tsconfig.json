{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": ["@tsconfig/recommended", "@tsconfig/node24", "@tsconfig/node-ts"],
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "outDir": "./dist",
    "target": "esnext",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["ESNext"],
  }
}
